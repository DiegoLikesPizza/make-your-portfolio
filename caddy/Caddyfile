# Production reverse proxy.
#
# Stock Caddy — no plugin build needed. Portfolios are served at /u/<handle> on
# this domain and on customers' own domains, so there is no wildcard hostname
# and therefore no DNS-01 challenge.
{
	email {$ACME_EMAIL}

	# On-demand TLS issues certificates for hostnames Caddy has never seen,
	# which is what custom domains need — and how you get your ACME rate limit
	# burned if anyone can point DNS here. `ask` gates every issuance on our
	# own database.
	on_demand_tls {
		ask      http://127.0.0.1:3000/api/caddy/authorize
		interval 2m
		burst    5
	}
}

# --- the app ---------------------------------------------------------------
# A single hostname, so a normal HTTP-01 challenge is enough. This record must
# be DNS-only in Cloudflare (grey cloud): if Cloudflare proxies it, it
# terminates TLS itself and Caddy can never complete the challenge.
{$APP_DOMAIN} {
	encode zstd gzip

	# Uploaded media is served straight off disk, never through Node.
	handle_path /assets/* {
		root * {$ASSETS_DIR}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# `ask` reaches the app on loopback directly. From outside, the endpoint
	# would tell anyone which hostnames are verified customer domains.
	handle /api/caddy/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

# --- customers' custom domains ---------------------------------------------
# Everything else that resolves here. A certificate is only issued if
# /api/caddy/authorize recognises the hostname as a verified Domain row.
:443 {
	tls {
		on_demand
	}
	encode zstd gzip

	handle_path /assets/* {
		root * {$ASSETS_DIR}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# `ask` reaches the app on loopback directly. From outside, the endpoint
	# would tell anyone which hostnames are verified customer domains.
	handle /api/caddy/* {
		respond 404
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
