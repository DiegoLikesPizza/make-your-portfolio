# ---- app -------------------------------------------------------------
# The root domain. Sites live at <subdomain>.APP_DOMAIN; the dashboard at
# app.APP_DOMAIN. Locally this is example.localhost (see README).
APP_DOMAIN="example.localhost"
NEXT_PUBLIC_APP_DOMAIN="example.localhost"
APP_URL="https://app.example.localhost"

# ---- database --------------------------------------------------------
POSTGRES_USER="portfolio"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="portfolio"
DATABASE_URL="postgresql://portfolio:change-me-in-production@localhost:5432/portfolio?schema=public"

# ---- auth (step 2) ---------------------------------------------------
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic links. Leave EMAIL_SERVER_HOST empty in development and the sign-in
# link is printed to the server console instead of being emailed.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="hello@example.localhost"

# Public IP of this server. Shown to users as the A record for apex domains,
# and used to verify that their DNS actually points here.
SERVER_IP=""

# ---- storage ---------------------------------------------------------
ASSETS_DIR="/data/assets"

# ---- caddy (step 8) --------------------------------------------------
# The wildcard cert for *.APP_DOMAIN needs a DNS-01 challenge, so Caddy must be
# built with the DNS plugin for whichever registrar hosts the zone.
DNS_API_TOKEN=""
