# ---- app -------------------------------------------------------------
# The root domain. Sites live at <subdomain>.APP_DOMAIN; the dashboard at
# app.APP_DOMAIN. Locally this is example.localhost (see README).
APP_DOMAIN="example.localhost"
NEXT_PUBLIC_APP_DOMAIN="example.localhost"

# The dashboard's public origin, e.g. "https://app.example.com". Auth.js builds
# every sign-in link from it; left empty, it uses the request's Host header,
# which the client controls. Required in production — without it the server
# answers every request with a 500 and logs why. Leave it empty in development
# to reach the app by LAN IP.
AUTH_URL=""

# ---- database --------------------------------------------------------
POSTGRES_USER="portfolio"
POSTGRES_PASSWORD="change-me-in-production"
POSTGRES_DB="portfolio"
DATABASE_URL="postgresql://portfolio:change-me-in-production@localhost:5432/portfolio?schema=public"

# ---- auth (step 2) ---------------------------------------------------
AUTH_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Magic links and contact form notifications. Leave EMAIL_SERVER_HOST empty in
# development and the sign-in link is printed to the server console instead of
# being emailed; contact messages then only appear in the dashboard.
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM="hello@example.localhost"

# Optional. "Import from GitHub" in the editor works without it, but GitHub
# then allows the whole server 60 requests an hour; a token raises that to
# 5,000. A fine-grained token with no permissions is enough.
GITHUB_TOKEN=""

# Public IP of this server. Shown to users as the A record for apex domains,
# and used to verify that their DNS actually points here.
SERVER_IP=""

# ---- storage ---------------------------------------------------------
ASSETS_DIR="/data/assets"

# ---- caddy (step 8) --------------------------------------------------
# The wildcard cert for *.APP_DOMAIN needs a DNS-01 challenge, so Caddy must be
# built with the DNS plugin for whichever registrar hosts the zone.
DNS_API_TOKEN=""

# ---- "write it for me" (optional) ------------------------------------
# Set this and the dashboard grows a page that turns a paragraph about the
# user into their portfolio copy. Leave it empty and the feature does not
# exist — no tab, and the route 404s — the same rule the OAuth providers
# follow, so a button and its capability can never disagree.
# Generations are billed to this key: https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# ---- custom-domain certificates (nginx deployments only) --------------
# Path to deploy/issue-cert.sh. Set it and a domain gets a real certificate and
# its own nginx server block the moment it verifies. Leave it empty on a Caddy
# deployment, where on-demand TLS does the same job through
# /api/caddy/authorize and needs nothing from the app.
CERT_ISSUE_COMMAND=""
